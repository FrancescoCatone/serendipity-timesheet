# Copia questo file in `.env.production` prima del deploy.
# I valori qui sotto sono esempi e vanno sostituiti con credenziali reali.

POSTGRES_DB=serendipity_db
POSTGRES_USER=serendipity
POSTGRES_PASSWORD=change-me-with-a-strong-db-password

SERVER_PORT=8080
JPA_DDL_AUTO=validate

JWT_SECRET=change-me-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRATION_MS=36000000

APP_ALLOWED_ORIGINS=https://www.serendipitycoop.it,https://serendipitycoop.it

APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_BOOTSTRAP_ADMIN_CODICE_FISCALE=
APP_BOOTSTRAP_ADMIN_NOME=
APP_BOOTSTRAP_ADMIN_COGNOME=
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=

FRONTEND_PORT=80
