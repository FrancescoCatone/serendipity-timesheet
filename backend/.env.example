# Questo file e` solo un esempio.
# Spring Boot non legge automaticamente questo file:
# le variabili vanno esportate nell'ambiente oppure usate in Docker Compose.

SPRING_PROFILES_ACTIVE=dev

DB_URL=jdbc:postgresql://localhost:5432/serendipity_db
DB_USERNAME=postgres
DB_PASSWORD=admin

JWT_SECRET=change-me-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRATION_MS=3600000

APP_ALLOWED_ORIGINS=http://localhost:5173

APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_BOOTSTRAP_ADMIN_CODICE_FISCALE=
APP_BOOTSTRAP_ADMIN_NOME=
APP_BOOTSTRAP_ADMIN_COGNOME=
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_SSL_ENABLE=false

APP_NOTIFICATIONS_ENABLED=false
APP_NOTIFICATIONS_RECIPIENT_EMAIL=
APP_NOTIFICATIONS_FROM_EMAIL=
APP_NOTIFICATIONS_SUBJECT_PREFIX=Serendipity
